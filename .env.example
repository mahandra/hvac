# Copy to .env and adjust. docker compose reads it automatically.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=0

# Host names / IPs the app is reached by (comma-separated). "*" accepts any.
ALLOWED_HOSTS=192.168.1.10,localhost,127.0.0.1
# Full origins incl. port, needed only if you reach the app through a different host/port mapping.
CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8001
# 1 = a TLS-terminating reverse proxy (sets X-Forwarded-Proto) is in front of the app.
BEHIND_HTTPS_PROXY=0

POSTGRES_DB=hvac
POSTGRES_USER=hvac
POSTGRES_PASSWORD=change-me-too

# A property is "Due" when it has no visit within this many days.
MAINTENANCE_INTERVAL_DAYS=180

TZ=America/New_York

# uid/gid the web container runs as; must own ./data/media on the host (see `id -u`, `id -g`).
APP_UID=1000
APP_GID=1000
